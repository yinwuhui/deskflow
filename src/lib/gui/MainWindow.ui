QWidget#sidebar { background: #f2f5fa; border-top-left-radius: 16px; border-bottom-left-radius: 16px; }
QWidget#rightPanel { background: #ffffff; border-top-right-radius: 16px; border-bottom-right-radius: 16px; }
QWidget#homeContent, QScrollArea#homeScroll { background: #ffffff; border: none; }
QWidget#topLevelWidget QLabel { background: transparent; border: none; }
QWidget#topLevelWidget QLabel[role="muted"] { color: #8b929c; font-size: 12px; }
QWidget#topLevelWidget QLabel[role="heading"] { font-size: 17px; font-weight: 600; }
QWidget#topLevelWidget QLabel[role="subheading"] { font-size: 14px; font-weight: 500; }
QWidget#topLevelWidget QLabel[role="value"] { font-size: 24px; color: #20262d; }
QWidget#topLevelWidget[compact="true"] QLabel[role="value"] { font-size: 21px; }
QWidget#topLevelWidget QLabel[role="profile"] { font-size: 15px; font-weight: 500; }
QWidget#topLevelWidget QLabel#lblAvatar { border-radius: 22px; background: #e1edff; }
QWidget#topLevelWidget QLabel[role="brand"] { font-size: 26px; font-weight: 600; color: #087fff; }
QWidget#topLevelWidget QLabel#lblVersion { font-size: 12px; color: #8b929c; }
QWidget#topLevelWidget QLabel[role="stateDot"] { background: #c6cbd1; border-radius: 3px; }
QWidget#topLevelWidget QLabel[role="stateDot"][ready="true"] { background: #32bb7b; }
QWidget#localCard { background: #f7f8fa; border-radius: 13px; }
QWidget#topLevelWidget QPushButton { background: transparent; border: 1px solid transparent; border-radius: 7px; padding: 8px 10px; }
QWidget#topLevelWidget QPushButton:hover { background: #edf4fd; }
QWidget#topLevelWidget QPushButton[keyboardFocus="true"] { border-color: #087fff; }
QWidget#topLevelWidget QPushButton:disabled { color: #a5acb5; }
QWidget#topLevelWidget QPushButton[role="navigation"] { text-align: left; padding: 13px 15px; font-size: 16px; color: #6e7682; }
QWidget#topLevelWidget QPushButton[role="navigation"]:checked { background: #e6edf6; color: #087fff; }
QWidget#topLevelWidget QPushButton[role="link"] { color: #217edb; font-size: 12px; padding: 7px 0; }
QWidget#topLevelWidget QPushButton#btnManageDevices { color: #8d95a0; }
QWidget#topLevelWidget QPushButton[role="pill"] { background: #f3f8ff; color: #1879df; border-radius: 20px; padding: 10px 20px; }
QWidget#topLevelWidget QPushButton[role="activePill"] { background: #087fff; color: white; border-radius: 20px; padding: 10px 20px; }
QWidget#topLevelWidget[compact="true"] QPushButton[role="pill"], QWidget#topLevelWidget[compact="true"] QPushButton[role="activePill"] { padding: 9px 18px; }
QWidget#topLevelWidget QPushButton[role="primary"] { background: #087fff; color: white; padding: 13px 26px; font-size: 16px; border-radius: 9px; }
QWidget#topLevelWidget QPushButton[role="primary"]:hover { background: #006fe8; }
QWidget#topLevelWidget QPushButton[role="primary"]:disabled { background: #bdd7f6; color: white; }
QWidget#topLevelWidget QPushButton[role="secondary"] { border: 1px solid #dce2e9; color: #6e7b8c; }
QWidget#topLevelWidget QPushButton[role="security"] { color: #6d9290; font-size: 12px; padding: 0; }
QWidget#topLevelWidget QPushButton[role="icon"] { color: #8a929d; border: none; padding: 3px; border-radius: 4px; }
QWidget#topLevelWidget QPushButton::menu-indicator { width: 0px; }
QWidget#topLevelWidget QPushButton[role="windowControl"] { padding: 0; border: none; border-radius: 5px; }
QWidget#topLevelWidget QPushButton#btnWindowClose { background: #ff6058; }
QWidget#topLevelWidget QPushButton#btnWindowMinimize { background: #ffbd2e; }
QWidget#topLevelWidget QPushButton#btnWindowZoom { background: #d3d7dc; }
QWidget#widgetModeSelection { background: #f7f8fa; border: 1px solid #e6e9ee; border-radius: 9px; }
QWidget#topLevelWidget HomeModeButton { font-size: 13px; padding: 0; border: none; }
QWidget#topLevelWidget QLineEdit { background: #ffffff; color: #555e69; border: 1px solid #d9dde3; border-radius: 9px; padding: 13px 15px; selection-background-color: #087fff; selection-color: white; }
QWidget#topLevelWidget QLineEdit:focus { border-color: #087fff; }
QWidget#topLevelWidget QListWidget { background: transparent; border: none; outline: 0; }
QWidget#homeFooter { border-top: 1px solid #f0f1f4; }
QWidget#homeFooter QLabel { font-size: 11px; color: #969da7; }
QWidget#permissionBanner { background: #fff6e6; border-radius: 9px; }
QWidget#topLevelWidget QLabel#lblPermissionNotice { color: #8a6126; font-size: 12px; }

QWidget#localCard QLabel[role="muted"] { font-size: 11px; }
QWidget#nameHeader QLabel, QWidget#addressHeader QLabel { font-size: 13px; }

QWidget#topLevelWidget[compact="true"] QLabel[role="brand"] { font-size: 24px; }
</string>
   </property>
