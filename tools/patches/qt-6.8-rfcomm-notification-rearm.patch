-    if (connectionNotification)
+    if (connectionNotification) {
         port = channelID;
+        // macOS 27 can consume notification readiness on an already-expired
+        // incoming channel while still returning a valid notification object.
+        // Rearm only the notification, without republishing the SDP service,
+        // while there are no active incoming channels.
+        if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 27) {
+            notificationRetry = [[NSTimer scheduledTimerWithTimeInterval:2.0
+                target:self selector:@selector(rearmRFCOMMNotification:)
+                userInfo:nil repeats:YES] retain];
+        }
+    }
 
