+
+- (void)rearmRFCOMMNotification:(NSTimer *)timer
+{
+    Q_UNUSED(timer);
+    if (!delegate || !port
+        || [IOBluetoothHostController defaultController].powerState != kBluetoothHCIPowerStateON)
+        return;
+    // Keep established channels undisturbed; resume readiness recovery after
+    // Qt has closed the last channel. Retaining a closed channel for up to
+    // one timer interval does not keep its underlying connection open.
+    for (NSInteger i = [acceptedChannels count]; i > 0; --i) {
+        if (![[acceptedChannels objectAtIndex:i - 1] isOpen])
+            [acceptedChannels removeObjectAtIndex:i - 1];
+    }
+    if ([acceptedChannels count])
+        return;
+    [connectionNotification unregister];
+    [connectionNotification release];
+    connectionNotification = nil;
+    connectionNotification = [[IOBluetoothRFCOMMChannel registerForChannelOpenNotifications:self
+        selector:@selector(rfcommOpenNotification:channel:) withChannelID:port
+        direction:kIOBluetoothUserNotificationChannelDirectionIncoming] retain];
 }
 
