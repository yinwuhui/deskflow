 QT_USE_NAMESPACE
 
@@ -34,6 +35,21 @@
     [connectionNotification release];
 
     [super dealloc];
+}
+
+- (void)stopListening
+{
+    if (!delegate)
+        return;
+    // IOBluetooth may already have queued a callback on the main queue.
+    // Invalidate its C++ target before unregistering, and keep this receiver
+    // alive until those callbacks have drained (Apple FB13705522).
+    delegate = nullptr;
+    [connectionNotification unregister];
+    [connectionNotification release];
+    connectionNotification = nil;
+    [self retain];
+    dispatch_async(dispatch_get_main_queue(), ^{ [self release]; });
 }
 
